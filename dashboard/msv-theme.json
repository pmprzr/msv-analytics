        "title": [{ "show": true, "fontColor": { "solid": { "color": "#0B3C8C" } }, "fontSize": 18 }],
        "background": [{ "show": true, "color": { "solid": { "color": "#FFFFFF" } }, "transparency": 0 }],
        "border": [{ "show": true, "color": { "solid": { "color": "#D5DEEC" } }, "radius": 6 }]
      }
    }
  }
