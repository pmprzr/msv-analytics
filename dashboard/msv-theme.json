{
  "name": "MSV Weiss-Blau",
  "dataColors": ["#0B3C8C", "#4DA3FF", "#F2A900", "#6B7A90", "#1E88A8", "#A3B8D6", "#082B66", "#7FC0FF"],
  "background": "#FFFFFF",
  "foreground": "#0B2A5B",
  "tableAccent": "#0B3C8C",
  "good": "#2E9E5B",
  "neutral": "#F2A900",
  "bad": "#D64545",
  "maximum": "#0B3C8C",
  "center": "#A3B8D6",
  "minimum": "#EAF1FB",
