    "callout": { "fontSize": 40, "fontFace": "Segoe UI Semibold", "color": "#0B3C8C" },
    "title": { "fontSize": 18, "fontFace": "Segoe UI Semibold", "color": "#0B3C8C" },
    "header": { "fontSize": 14, "fontFace": "Segoe UI Semibold", "color": "#0B3C8C" },
    "label": { "fontSize": 14, "fontFace": "Segoe UI", "color": "#0B2A5B" }
  },
  "visualStyles": {
