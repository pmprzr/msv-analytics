# Kopiere diese Datei nach ".env" und passe das Passwort an:
#   cp .env.example .env
#
# Passwort-Regeln von SQL Server: mind. 8 Zeichen, Gross- und Kleinbuchstaben
# sowie Ziffern oder Sonderzeichen. Bitte KEIN "$" und keine Anfuehrungszeichen
# verwenden (Docker Compose wuerde sie sonst anders auslesen).
MSSQL_SA_PASSWORD=ChangeMe_Str0ng!Pass

# Optional: Port auf deinem Rechner, falls 1433 schon belegt ist
MSSQL_PORT=1433
